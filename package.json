{
  "name": "gejian-games",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "格间小游戏：React + Fastify + MySQL 自托管游戏平台",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7100",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "node scripts/build-guides.mjs && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --env-file-if-exists=.env --test tests/api.integration.mjs",
    "test:browser": "node tests/puzzle-ui.browser.mjs && node tests/scores.browser.cjs && node tests/stats.browser.mjs && node tests/tetris.browser.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  }
}
